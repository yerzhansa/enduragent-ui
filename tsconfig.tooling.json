{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src",
    "stories",
    ".storybook",
    "tests/*.ts",
    "tests/*.tsx",
    "tests/browser/*.ts",
    "tools/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
