{
  "name": "@enduragent/ui",
  "version": "0.1.0",
  "description": "Shared Enduragent controls, patterns, and theme",
  "license": "MIT",
  "files": [
    "dist",
    "NOTICE.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailwind.css": "./dist/tailwind.css"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.tooling.json && pnpm check:runtime",
    "test": "vitest run",
    "prepack": "pnpm build",
    "storybook": "pnpm build && storybook dev --host 127.0.0.1 -p 5188 --no-open --disable-telemetry",
    "build-storybook": "pnpm build && storybook build --output-dir dist-storybook --disable-telemetry",
    "check:runtime": "node --experimental-strip-types --input-type=module -e \"import { verifyRuntimeGraph } from './tools/package-isolation.ts'; verifyRuntimeGraph(process.cwd());\"",
    "check:packed": "node tools/check-packed.mjs",
    "check:ui": "pnpm build-storybook && playwright test",
    "release-version": "node tools/release-version.mjs",
    "test:release": "node --test tests/release-semver.test.mjs tests/release-version.test.mjs tests/verify-release.test.mjs tests/github-release.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.28.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "30.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.4"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.19.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yerzhansa/enduragent-ui.git"
  },
  "homepage": "https://github.com/yerzhansa/enduragent-ui#readme"
}
